{
  // Anti-dead-code gate. Knip finds what ESLint's `no-unused-vars` can't:
  // whole unused files, exports/types no other module imports, and
  // dependencies declared in package.json but never used (plus the inverse —
  // imports with no matching dependency). Run with `npm run knip`; enforced by
  // .github/workflows/knip.yml.
  //
  // Every issue type knip reports is an error — that is its default severity,
  // so this file sets no `rules`. The pre-existing unused exports/types
  // backlog is held at its current size instead: `npm run knip` runs knip
  // twice, once over every other class, then once over `exports,types` under
  // `--max-issues`. That number is a ceiling, not a licence — it fails the job
  // the moment the backlog grows, and drops as follow-up passes pay it down.
  //
  // Out of scope entirely: build output and dependencies (git-ignored, so knip
  // skips them), the argent-private submodule (excluded below), and every file
  // that is not JavaScript or TypeScript (knip's DEFAULT_EXTENSIONS).
  "$schema": "https://unpkg.com/knip@5/schema.json",

  // Stale exemptions in this file are a failure, not a footnote: knip's
  // configuration hints report an entry that no longer suppresses anything,
  // and this makes them exit non-zero like any other finding.
  "treatConfigHintsAsErrors": true,

  // The submodule ships from its own repo and has its own CI. It becomes a
  // workspace only once `git submodule update --init` puts a package.json
  // under packages/argent-private for the root `packages/*` glob to match —
  // this entry is what keeps it out of the gate then. eslint and prettier skip
  // it the same way.
  "ignoreWorkspaces": ["packages/argent-private"],

  "workspaces": {
    // Root workspace: build/dev/release/CI scripts. Knip reaches these on its
    // own, from package.json's `scripts` and from `run:` steps in
    // .github/workflows — its github-actions plugin reads multi-line `run: |`
    // blocks too, which is how scripts/next-canary-version.mjs resolves though
    // it is invoked from nothing else. What the plugin does not parse is a
    // PowerShell body, so the Windows E2E driver — invoked from the
    // windows-latest job, where that is the default shell — is declared here
    // by hand.
    //
    // Scope limit: only 11 of the 30 files under scripts/ are in the gate at
    // all, because knip analyzes JS/TS and nothing else. The 15 `.sh` files,
    // e2e-full/lib/report.py and ci/e2e-chromium-page.html are invisible to it
    // however they are reached — that covers the whole scripts/e2e-full/
    // harness, which nothing outside its own directory references.
    ".": {
      "entry": ["scripts/ci/windows-chromium-e2e.mjs"],
    },

    // @swmansion/argent is a thin dispatcher whose real payload is an esbuild
    // bundle of the OTHER workspaces (see scripts/bundle-tools.cjs). The
    // hand-written dispatcher copied into bin/ at build time is an entry, not
    // dead code.
    //
    // Knip cannot follow imports across that esbuild boundary, so every
    // package consumed only by the bundled-in code reads as unused here. Those
    // are named one by one rather than waved through with a catch-all pattern:
    // `ignoreDependencies` also suppresses `unlisted` and `unresolved`, and a
    // catch-all would take this workspace's own src/ and scripts/ out of those
    // two checks — where an import with no matching declaration is a real bug,
    // not a bundler artifact.
    //
    // Unchecked in either direction: knip does not inspect
    // `optionalDependencies` at all, so `electron` and `node-pty` are outside
    // the gate here, as is argent-cli's runtime `createRequire("node-pty")`.
    "packages/argent": {
      "entry": ["scripts/argent-simulator-server.cjs"],
      "ignoreDependencies": [
        // dependencies
        "@fails-components/webtransport",
        "@fails-components/webtransport-transport-http3-quiche",
        "@modelcontextprotocol/sdk",
        "tree-sitter",
        "tree-sitter-typescript",
        // devDependencies
        "@argent/telemetry",
        "@clack/prompts",
        "@types/semver",
        "picocolors",
        "posthog-node",
        "semver",
        "smol-toml",
        "yaml",
      ],
    },

    // tool-server reaches a few packages in ways knip can't trace statically.
    // `ignoreDependencies` works in both directions, so this one list silences
    // two different issue classes; they are kept apart below so each entry's
    // stated reason matches the finding it actually suppresses.
    //
    // Each entry exempts the NAME across the whole workspace, not the call
    // site it documents: while `sharp` is listed, an undeclared import of it
    // from any file here passes too. Knip offers nothing narrower, so the list
    // holds only packages this workspace genuinely cannot declare.
    "packages/tool-server": {
      "ignoreDependencies": [
        // --- Declared in package.json, loaded too dynamically to detect.
        //     Without these: "unused dependencies". ---
        // Dynamic `_require("tree-sitter")` / `_require("tree-sitter-typescript")`
        // in react-profiler/pipeline/.../ast-index.ts (pinned + lazy-loaded).
        "tree-sitter",
        "tree-sitter-typescript",
        // Runtime companion of the dynamically imported
        // `@fails-components/webtransport`; loaded internally, never imported.
        "@fails-components/webtransport-transport-http3-quiche",

        // --- Imported here but deliberately absent from this package.json.
        //     Without these: "unlisted dependencies". ---
        // Lazy `require("sharp")` in chromium-server/screenshot.ts. Kept out of
        // the manifest on purpose so the ~30 MB native binary isn't a cost every
        // consumer pays; the caller degrades gracefully when it isn't installed.
        "sharp",
        // `require("electron")` twice, for two different reasons. In
        // utils/preview-window.ts it resolves the Electron executable's path
        // from the install root, where it is an optionalDependency of the
        // published @swmansion/argent. In test/fixtures/electron-smoke-app it
        // is the Electron main-process API, supplied by the runtime that
        // executes the fixture.
        "electron",
      ],
    },
  },

  // Blind spot in the `files` check: test files are entry points, so a
  // production module that nothing but its own test imports still counts as
  // reached. What separates dead from merely test-only is whether a test
  // exercises the module or just names it — a module whose sole reference is a
  // catalog roll-call is unreachable in production and gets deleted. Two sit
  // in the blind spot on the other side of that line and stay:
  // src/tools/paste/index.ts (keyboard-secrets.test.ts drives it and asserts
  // the `cmd: "paste"` it sends) and src/utils/ios-profiler/lifecycle.ts
  // (ios-instruments/lifecycle.test.ts runs the shutdown ladder through it).
  //
  // `knip --production` is the lens that reports the whole class, and the repo
  // is not clean under it: 13 unused files — those two, seven root scripts,
  // packages/argent/scripts/{bundle-tools,observe,sync-readme}.cjs and
  // packages/registry/tests/helpers.ts — with the export/type backlog rising
  // to 227/206. So a production-mode pass is a follow-up of its own, not a
  // flag to flip here.
}
