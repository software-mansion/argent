{
  "name": "argent-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "!packages/docs",
    "!packages/argent-alias"
  ],
  "scripts": {
    "build": "bun run --filter @swmansion/argent build:tool-args && tsc --build && node packages/tool-server/scripts/copy-build-assets.mjs",
    "start": "bun run --filter @argent/registry build && bun run --filter @argent/tool-server dev",
    "start:tool-server": "bun run --filter @argent/registry build && bun run --filter @argent/tool-server dev",
    "download:simulator-server": "bash scripts/download-simulator-server.sh",
    "download:native-binaries": "bash scripts/download-native-binaries.sh",
    "download:trace-processor": "bash scripts/download-trace-processor.sh",
    "build:ios-binaries": "bash packages/native-devtools-ios/scripts/build.sh dev",
    "build:ios-binaries:tcp": "bash packages/native-devtools-ios/scripts/build.sh dev --transport tcp",
    "build:android-binaries": "bash packages/native-devtools-android/scripts/build.sh",
    "pack": "node scripts/pack-mcp.cjs",
    "pack:mcp": "node scripts/pack-mcp.cjs",
    "pack:mcp:local": "bun run download:simulator-server && bun run build:ios-binaries && bun run build:ios-binaries:tcp && bun run build:android-binaries && bun run download:trace-processor && bun run build && bun run --filter @swmansion/argent build && bun pm pack --cwd packages/argent --destination .",
    "dev": "node scripts/dev.cjs",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "knip": "knip --include nsExports,nsTypes --max-issues 0",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test:scripts": "node --test scripts/sync-next-dist-tag.test.mjs scripts/extract-tools.test.mjs scripts/next-canary-version.test.mjs scripts/check-workspace-versions.test.mjs",
    "check:versions": "node scripts/check-workspace-versions.mjs",
    "harness-check": "node scripts/harness-check/harness-check.mjs",
    "render:agent-context": "node scripts/render-agent-context.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "@fails-components/webtransport-transport-http3-quiche",
    "dtrace-provider",
    "esbuild",
    "node-pty",
    "tree-sitter",
    "tree-sitter-javascript",
    "tree-sitter-typescript"
  ]
}
